{
  "version": 1,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "methods": ["POST"],
      "dest": "app.py"
    },
    {
      "src": "/api/messages",
      "methods": ["GET"],
      "dest": "app.py"
    }
  ]
}
